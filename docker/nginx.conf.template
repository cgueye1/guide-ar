map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;

  root  /usr/share/nginx/html;
  index index.html;

  # ── sécurité ──
  add_header X-Content-Type-Options "nosniff"    always;
  add_header X-Frame-Options        "SAMEORIGIN" always;
  add_header Referrer-Policy        "no-referrer-when-downgrade" always;
  # la caméra doit rester autorisée sur cette origine
  add_header Permissions-Policy     "camera=(self), microphone=(), geolocation=(self)" always;

  # ── compression ──
  gzip            on;
  gzip_vary       on;
  gzip_min_length 512;
  gzip_comp_level 6;
  gzip_types      text/plain text/css application/javascript application/json
                  image/svg+xml application/manifest+json;

  client_max_body_size 12M;

  # ── santé ──
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # ── config.js : jamais mis en cache ──
  location = /config.js {
    add_header Cache-Control "no-store, must-revalidate";
    expires -1;
  }

  # ── proxy vers le backend Spring Boot ──
  location /api/ {
    proxy_pass ${BACKEND_URL}/api/;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # la reconnaissance Vertex AI prend 2 à 4 secondes
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    proxy_request_buffering off;
  }

  # ── assets : cache long ──
  location ~* \.(css|js|woff2?|svg|png|jpe?g|webp|ico)$ {
    expires 30d;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # ── application ──
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
